{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun"],

    // Rigor de tipos (requisito: TypeScript estrito, sem `any`).
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "useUnknownInCatchVariables": true,

    // Decorators do NestJS. O guia (2.2) assume que o Bun NÃO emite
    // design:paramtypes; por isso TODA injeção usa @Inject(TOKEN) explícito,
    // mesmo com emitDecoratorMetadata ligado aqui (ele só serve ao tsc).
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src", "test", "migrations"]
}
