# ---------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------
PORT=3000
LOG_LEVEL=info

# ---------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=wagering
# Usuário de migração (dono do schema). No compose, a app usa outro login.
DATABASE_USER=wagering
DATABASE_PASSWORD=wagering
# Opcional, lido só por `bun run migrate:up`: provisiona um login de runtime
# sem ser dono das tabelas (membro de wagering_app). Para rodar a app local com
# privilégio mínimo, aponte DATABASE_USER/PASSWORD da app para ele.
# DATABASE_APP_USER=wagering_service
# DATABASE_APP_PASSWORD=wagering_service
DATABASE_POOL_MAX=20
# lock_timeout por transação: esperar o lock de uma wallet além disso = 503 / retry
DATABASE_LOCK_TIMEOUT_MS=5000

# ---------------------------------------------------------------------
# AWS SQS (LocalStack). As credenciais são fictícias, só para o LocalStack.
# ---------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_TRANSACTIONS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_TRANSACTIONS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo
# Tentativas antes da DLQ e visibility timeout (> tempo máximo de processamento).
# O consumidor lê o maxReceiveCount da RedrivePolicy da fila ao iniciar; este
# valor só vale enquanto a fila não pôde ser consultada ou se ela não tiver redrive.
SQS_MAX_RECEIVE_COUNT=5
SQS_VISIBILITY_TIMEOUT_SECONDS=60
SQS_WAIT_TIME_SECONDS=20
SQS_CONSUMER_NAME=wager-transactions-consumer
# Backoff de retry de mensagem (ChangeMessageVisibility): base 5 s, teto 5 min
SQS_RETRY_BASE_SECONDS=5
SQS_RETRY_MAX_SECONDS=300

# ---------------------------------------------------------------------
# Outbox (publisher)
# ---------------------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=50
OUTBOX_RETRY_MAX_SECONDS=300
OUTBOX_LAG_ALERT_ATTEMPTS=10
# Amostragem de outbox_pending_total / outbox_lag_seconds (mínimo 100 ms)
OUTBOX_METRICS_INTERVAL_MS=5000

# ---------------------------------------------------------------------
# PENDING_REFERENCE (§7.1): TTL 1 h, backoff 2 s ×2 até 5 min, 20 tentativas
# ---------------------------------------------------------------------
PENDING_REFERENCE_TTL_SECONDS=3600
PENDING_REFERENCE_BACKOFF_BASE_SECONDS=2
PENDING_REFERENCE_BACKOFF_MAX_SECONDS=300
PENDING_REFERENCE_MAX_ATTEMPTS=20
PENDING_REFERENCE_POLL_INTERVAL_MS=1000

# Liga/desliga os workers nesta instância (útil para testes de múltiplas instâncias)
WORKERS_ENABLED=true

# ---------------------------------------------------------------------
# Injeção de falha — SÓ para os testes de crash (Etapa 18). Nunca em produção.
# true = o processo morre (SIGKILL) depois do commit e antes do ack da mensagem SQS.
# ---------------------------------------------------------------------
FAULT_CRASH_AFTER_COMMIT_BEFORE_ACK=false
